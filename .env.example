# Root environment for Docker Compose (PostgreSQL + FastAPI backend).
# Copy this file to `.env` and adjust values for your machine.
# Do NOT commit the real `.env` file and do NOT put real secrets in source.

POSTGRES_USER=adip
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=adip
POSTGRES_PORT=5432

BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
