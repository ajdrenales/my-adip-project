# Backend environment (local development without Docker).
# Copy this file to `backend/.env`. Never commit the real `.env`.

# Local PostgreSQL (matches docker-compose defaults).
DATABASE_URL=postgresql+psycopg://adip:change_me_locally@localhost:5432/adip

APP_NAME=ADIP Local Backend
APP_VERSION=0.1.0
ENVIRONMENT=development

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
